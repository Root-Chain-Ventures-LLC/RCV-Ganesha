# Copy to .env (./install.sh does this for you) and fill in real values.
# Never commit .env.

# --- Required ---------------------------------------------------------------

# Master key for encrypting every credential saved in Settings (directory/SSO client
# secrets, the Geotab password, the SMTP password, Document AI API keys, the Teams webhook)
# before it reaches the database. The app refuses to start without it.
# 32 bytes, as base64 or 64 hex characters. Generate one with:
#   openssl rand -hex 32
# ./install.sh generates it for you when this is empty. BACK IT UP: if it is lost, every
# stored credential is unrecoverable and has to be re-entered.
GANESHA_SECRET_KEY=

# Alternative to GANESHA_SECRET_KEY: a path to a file holding the same value (Docker or
# Kubernetes secret mounts). Set one or the other.
# GANESHA_SECRET_KEY_FILE=

# Former keys, comma-separated, kept readable during a key rotation. Leave unset otherwise.
# GANESHA_SECRET_KEY_PREVIOUS=

# Password for the bundled Postgres. Use letters and digits only (it is placed inside a
# connection URL). Generate one with:
#   openssl rand -hex 24
# ./install.sh generates it for you when this is empty. Set it before the first start: the
# database volume keeps the password it was created with.
GANESHA_DB_PASSWORD=

# The public URL people type to reach Ganesha, exactly (scheme, host and port). It decides
# the Secure flag on cookies, HSTS, and the same-origin check on every state-changing
# request, so it must match what the browser shows.
# The app REFUSES TO START unless this is https://, because session cookies would otherwise
# go out without the Secure flag. Ganesha speaks plain HTTP itself: put a reverse proxy
# that terminates TLS in front of it.
BASE_URL=https://ganesha.example.com

# For a local trial over plain http (BASE_URL=http://localhost:8080) opt out explicitly.
# Never set this on a deployment reachable from the internet.
# ALLOW_INSECURE_HTTP=true

# --- Network ----------------------------------------------------------------

# Which host interface and port publish the app (the container itself always listens on
# 8080). Behind a reverse proxy on the same machine use GANESHA_BIND=127.0.0.1 so the app
# is reachable only through the proxy. The default publishes on every interface.
# GANESHA_BIND=0.0.0.0
# GANESHA_PORT=8080

# Whether to trust X-Forwarded-* headers (client IP, protocol). Default false = ignore.
# Behind a reverse proxy set ONE of:
#   TRUST_PROXY=1                          trust exactly one proxy hop (a single reverse
#                                          proxy; use 2 if a cloud load balancer sits in
#                                          front of it)
#   TRUST_PROXY=10.0.0.0/8,192.0.2.5       trust only these proxy IPs / CIDR ranges
#                                          (strongest)
#   TRUST_PROXY=true                       trust every hop (a client that can reach the app
#                                          directly can then spoof its IP; avoid)
# TRUST_PROXY=false

# Optional first-run guard. When set, creating the first administrator at /setup also needs
# this value (the setup page shows an extra field). Use it on any install that can be
# reached before you have signed in once. Remove it afterwards if you like.
# SETUP_TOKEN=

# Outbound connections (Document AI, the OIDC issuer, SMTP, the Teams webhook) to loopback,
# link-local and cloud-metadata addresses are always refused. Private ranges (RFC 1918,
# CGNAT, unique-local) are refused too unless you set this to true. You need it for an
# on-premises model server, a LAN mail relay or an internal identity provider.
# ALLOW_PRIVATE_OUTBOUND=false

# --- Upload limits ----------------------------------------------------------

# Uploads per person per hour across every upload route (429 beyond it). Default 30.
# UPLOAD_RATE_PER_HOUR=30
# Images larger than this many megapixels are refused before decoding. Default 40.
# MAX_IMAGE_MEGAPIXELS=40
# Stop waiting for a stuck image/PDF decode after this many milliseconds. Default 20000.
# IMAGE_DECODE_TIMEOUT_MS=20000

# --- Sessions ---------------------------------------------------------------

# Sliding idle timeout (hours), absolute lifetime (days) and concurrent sessions per person
# (the oldest is dropped). Defaults: 12 / 7 / 10.
# SESSION_IDLE_TIMEOUT_HOURS=12
# SESSION_ABSOLUTE_DAYS=7
# MAX_SESSIONS_PER_PERSON=10

# --- Container sizing -------------------------------------------------------

# The app container is read-only with all capabilities dropped; these cap its memory and
# process count. Defaults: 1g / 256.
# GANESHA_MEM_LIMIT=1g
# GANESHA_PIDS_LIMIT=256

# --- Database ---------------------------------------------------------------

# Host port the bundled Postgres publishes on (loopback only). Default 5434.
# GANESHA_DB_PORT=5434

# To use your own Postgres (14 or newer) instead of the bundled one, edit docker-compose.yml:
# point the app's DATABASE_URL at it and remove the `db` service and the app's `depends_on`.
# (A DATABASE_URL set here would be overridden by the one in docker-compose.yml.) On
# Kubernetes DATABASE_URL always comes from the Secret; see deploy/k8s/README.md.

# Maximum Postgres connections the app opens. Default 10.
# PG_POOL_MAX=10

# --- Version ----------------------------------------------------------------

# Which published image to run (a release version such as 0.1.5, without a leading "v").
# Defaults to the version this docker-compose.yml shipped with. Releases are listed at
# https://github.com/Root-Chain-Ventures-LLC/RCV-Ganesha/releases
# GANESHA_VERSION=0.1.5

# --- Optional integrations --------------------------------------------------
# The Microsoft 365 directory, Entra/OIDC sign-in, Geotab, Document AI, email and Teams
# settings all live in the app under Settings (administrators only) and are stored,
# encrypted, in the database. Do not put those credentials here.

# Timeout for every Document AI provider call. Default 60000 (60 s).
# DOCAI_FETCH_TIMEOUT_MS=60000
# Timeout for every Geotab request. Default 30000 (30 s).
# GEOTAB_FETCH_TIMEOUT_MS=30000
